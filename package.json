{
  "name": "pokemon-card-binder",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "assets:inventory": "node scripts/card-assets-manifest.mjs",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "build": "vp run fbtee:all && vp -C . build",
    "catalog:import": "vpx scripts/catalog.ts && vp run catalog:translations && void db execute --file .void/catalog.sql",
    "catalog:sync": "wrangler d1 execute DB --config .void-wrangler.jsonc --remote --file .void/catalog.sql --yes",
    "catalog:translations": "node scripts/card-translations.mjs",
    "db:generate": "void db generate",
    "db:migrate": "void db migrate",
    "deploy": "vp run fbtee:all && void deploy --platform cloudflare",
    "dev": "vp -C . dev",
    "dev:setup": "void prepare && void db migrate && vp run catalog:import",
    "fbtee:all": "vp run fbtee:collect && vp run fbtee:translate",
    "fbtee:collect": "fbtee collect --src src/i18n --out source_strings.json",
    "fbtee:translate": "node scripts/translations.mjs && fbtee translate --translations translations/de-DE.json translations/ja-JP.json --output-locale-style=bcp47",
    "pkmn": "node packages/pocket-folio/cli/pocket-folio.mjs",
    "prepare": "vp hooks enable",
    "prepare:void": "void prepare",
    "preview": "vp -C . preview",
    "ship": "vp run test:all && vp run test:agent-package && vp run build && vp -C packages/pocket-folio pm publish --access public",
    "social:preview": "node scripts/social-preview.mjs",
    "test": "vp test",
    "test:agent-package": "node scripts/agent-package-test.mjs",
    "test:all": "vp check && vp test && node --test tests/*.test.mjs",
    "test:api": "node scripts/test-browser.mjs --api",
    "test:browser": "node scripts/test-browser.mjs",
    "test:catalog-import": "vpx scripts/catalog.ts && node scripts/catalog-import-test.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.16",
    "@astryxdesign/theme-neutral": "^0.7.16",
    "@better-auth/api-key": "1.7.25",
    "@fontsource-variable/geist": "^5.3.0",
    "@nkzw/fate": "2.2.3",
    "@nkzw/fate-indexeddb": "2.2.3",
    "@nkzw/typeahead": "^0.1.0",
    "@stylexjs/stylex": "^0.19.2",
    "@void/react": "1.10.0",
    "better-auth": "^1.7.25",
    "drizzle-orm": "^0.45.4",
    "fbtee": "^6.0.0",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-fate": "2.2.3",
    "void": "1.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.16",
    "@cloudflare/workers-types": "5.20261116.1",
    "@nkzw/fbtee-compiler": "^6.0.0",
    "@nkzw/oxlint-config": "^2.0.1",
    "@nkzw/vite-plugin-fbtee": "^6.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxc-transform-react": "^0.158.0",
    "playwright": "1.65.1",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.164.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.21.0"
}
